# Токен бота от @BotFather
BOT_TOKEN=

# Чат, куда приходят заказы (ваш личный id или id группы бариста, у групп он с минусом)
# Узнать id: напишите боту @userinfobot или добавьте @getmyid_bot в группу
ADMIN_CHAT_ID=

# Ключ Claude API (console.anthropic.com). Без него бот работает только на кнопках
ANTHROPIC_API_KEY=

# Модель для ИИ-консультанта
CLAUDE_MODEL=claude-opus-5-5

DB_PATH=data/orders.db
